# Local-only defaults for Docker Compose and Spring services.
# These values are for loopback development only; replace credentials before deployment.
POSTGRES_DB=lifemate_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

REDIS_PORT=6379
REDIS_HOST=localhost

RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672
RABBITMQ_HOST=localhost
RABBITMQ_USER=guest
RABBITMQ_PASS=guest

DB_URL=jdbc:postgresql://localhost:5432/lifemate_db
DB_USERNAME=postgres
DB_PASSWORD=postgres
AI_AGENT_URL=http://localhost:8000
EXPENSE_SERVICE_URL=http://localhost:8081

GATEWAY_AUTH_ENABLED=false
GATEWAY_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
GATEWAY_RATE_REPLENISH=10
GATEWAY_RATE_BURST=20

BUDGET_ALERT_RETRY_ATTEMPTS=3
BUDGET_ALERT_RETRY_DELAY_MS=2000
EXPENSE_SERVICE_CONNECT_TIMEOUT_MS=2000
EXPENSE_SERVICE_READ_TIMEOUT_MS=5000
OUTBOX_POLL_DELAY_MS=1000
OUTBOX_CONFIRM_TIMEOUT_MS=5000
